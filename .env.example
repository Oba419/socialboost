# =============================================================================
# SocialBoost AI — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Every integration is optional: when its variables are missing the app shows
# an explicit "awaiting setup" state instead of faking success.
# =============================================================================

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SocialBoost AI"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Show clearly-labelled demo charts in Analytics (never stored as real data).
NEXT_PUBLIC_DEMO_MODE=false

# --- Supabase (database, auth, storage) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Required for AI credit metering, webhooks, cron jobs, admin and token storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Security ----------------------------------------------------------------
# 32 random bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Random string (32+ chars) used to sign OAuth state cookies.
OAUTH_STATE_SECRET=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- AI provider -------------------------------------------------------------
# Set ONE of the keys below. If both are set, OpenAI is used unless AI_PROVIDER says otherwise.
# AI_PROVIDER=gemini
#
# Google Gemini (free tier available, no card): https://aistudio.google.com/apikey
# Note: Google may use free-tier inputs to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-3.6-flash
GEMINI_MODEL_ADVANCED=gemini-3.6-flash
# Used automatically when the main model is overloaded (HTTP 503/429).
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
#
# OpenAI (paid, requires credit)
OPENAI_API_KEY=
# Model ids are configurable; pick current models from your OpenAI account.
OPENAI_MODEL_DEFAULT=gpt-5-mini
OPENAI_MODEL_ADVANCED=gpt-5
OPENAI_MAX_OUTPUT_TOKENS=4000

# --- Paystack ----------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
# Webhook URL to register in the Paystack dashboard: <APP_URL>/api/webhooks/paystack
# (Paystack signs webhooks with your secret key; no separate webhook secret.)

# --- Email (optional, Resend) ------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="SocialBoost AI <notifications@yourdomain.com>"
CONTACT_INBOX_EMAIL=

# --- Social platform OAuth apps (all optional) -------------------------------
# Redirect URI for every platform: <APP_URL>/api/social/<platform>/callback
# Meta (Facebook Pages + Instagram Professional accounts)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- E2E tests (optional) ----------------------------------------------------
# A confirmed test user in a NON-production Supabase project.
E2E_EMAIL=
E2E_PASSWORD=
